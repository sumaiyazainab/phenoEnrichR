# ============================================================
# enrichment.R
# phenoEnrichR enrichment, table, plotting, and example functions
#
# Purpose:
# This file contains the main user-facing functions.
#
# Main user function:
# run_pheno_enrichment()
#
# Users choose ONE ontology:
# ontology = "HPO" for human phenotype enrichment
# ontology = "MP"  for mouse phenotype enrichment via orthologues
#
# Users cannot choose "both" in this simplified version.
# ============================================================


#' Run phenotype enrichment with Fisher's exact test
#'
#' Tests whether phenotype terms are overrepresented in the user gene set.
#'
#' @param genes User-supplied genes.
#' @param universe Background gene universe.
#' @param annotations Data frame with gene and term_id.
#' @param min_size Minimum genes required per term.
#' @return Enrichment result table.
#' @export
run_fisher_enrichment <- function(genes, universe, annotations, min_size = 5) {

  # Clean input vectors.
  genes <- unique(as.character(genes))
  universe <- unique(as.character(universe))

  # Standardise annotation table.
  annotations <- as.data.frame(annotations, stringsAsFactors = FALSE)

  # Check required columns exist.
  if (!all(c("gene", "term_id") %in% names(annotations))) {
    stop("annotations must contain columns called gene and term_id")
  }

  # Keep only required columns.
  annotations <- annotations[, c("gene", "term_id")]
  annotations$gene <- as.character(annotations$gene)
  annotations$term_id <- as.character(annotations$term_id)

  # Restrict to genes in the background universe.
  annotations <- annotations[
    !is.na(annotations$gene) &
      !is.na(annotations$term_id) &
      annotations$gene %in% universe,
  ]

  # Make term-to-gene mapping.
  term2genes <- split(annotations$gene, annotations$term_id)
  term2genes <- lapply(term2genes, unique)

  # Remove very small terms to reduce noisy results.
  term2genes <- term2genes[lengths(term2genes) >= min_size]

  # Return empty result safely if no terms can be tested.
  if (length(term2genes) == 0) {
    return(data.frame(
      term_id = character(),
      selected_with_term = integer(),
      selected_without_term = integer(),
      background_with_term = integer(),
      background_without_term = integer(),
      p_value = numeric(),
      padj = numeric(),
      stringsAsFactors = FALSE
    ))
  }

  # Run Fisher test for each term.
  results <- lapply(names(term2genes), function(term) {

    genes_with_term <- unique(term2genes[[term]])

    # a = input genes with the phenotype term.
    a <- sum(genes %in% genes_with_term)

    # b = input genes without the phenotype term.
    b <- sum(!(genes %in% genes_with_term))

    # c = background genes with the term, excluding input genes.
    c <- sum((universe %in% genes_with_term) & !(universe %in% genes))

    # d = background genes without the term, excluding input genes.
    d <- sum(!(universe %in% genes_with_term) & !(universe %in% genes))

    # Build 2x2 contingency table.
    mat <- matrix(c(a, b, c, d), nrow = 2, byrow = TRUE)

    # Fisher's exact test.
    p_value <- fisher.test(mat)$p.value

    data.frame(
      term_id = term,
      selected_with_term = a,
      selected_without_term = b,
      background_with_term = c,
      background_without_term = d,
      p_value = p_value,
      stringsAsFactors = FALSE
    )
  })

  # Combine results.
  results <- dplyr::bind_rows(results)

  # Add Benjamini-Hochberg FDR correction.
  results$padj <- p.adjust(results$p_value, method = "BH")

  # Sort strongest enrichment first.
  results <- results[order(results$p_value), ]
  rownames(results) <- NULL

  results
}


#' Add readable ontology term names
#'
#' Converts term IDs such as HP:0000518 or MP:0001303 into readable names.
#'
#' @param results Enrichment result table.
#' @param term_info Parsed ontology table.
#' @return Results with term_name column added.
#' @export
add_term_names <- function(results, term_info) {

  # Keep one name per ontology term.
  term_names <- unique(term_info[, c("term_id", "term_name")])

  # Merge readable names onto enrichment results.
  merge(
    results,
    term_names,
    by = "term_id",
    all.x = TRUE
  )
}


#' Filter broad ontology terms
#'
#' Removes terms that are too general for useful interpretation.
#'
#' @param results Enrichment results.
#' @param exclude_terms Term names to remove.
#' @param max_background Maximum allowed background term size.
#' @return Filtered results.
#' @export
filter_results_basic <- function(results,
                                 exclude_terms = c(
                                   "Mode of inheritance",
                                   "Autosomal dominant inheritance",
                                   "Autosomal recessive inheritance",
                                   "mammalian phenotype"
                                 ),
                                 max_background = Inf) {

  # Work on a copy.
  out <- results

  # Remove unwanted broad term names.
  if ("term_name" %in% names(out)) {
    out <- out[!(out$term_name %in% exclude_terms), ]
  }

  # Remove very broad terms based on background size.
  out <- out[out$background_with_term <= max_background, ]

  rownames(out) <- NULL
  out
}


#' Run HPO enrichment
#'
#' Runs Human Phenotype Ontology enrichment for human genes.
#'
#' @param genes User gene input.
#' @param gene_col Column name if genes is a data frame or file.
#' @param hpo_obo_path Path to hp.obo.
#' @param hpo_annotation_path Path to genes_to_phenotype.txt.
#' @param universe Optional background genes.
#' @param min_size Minimum genes per term.
#' @param propagate Whether to propagate annotations to parent terms.
#' @return HPO enrichment object.
#' @export
run_hpo_enrichment <- function(genes,
                               gene_col = NULL,
                               hpo_obo_path = "data-raw/hp.obo",
                               hpo_annotation_path = "data-raw/genes_to_phenotype.txt",
                               universe = NULL,
                               min_size = 5,
                               propagate = TRUE) {

  # Clean user input genes.
  genes <- clean_gene_input(genes, gene_col = gene_col)

  # Parse HPO ontology.
  term_info <- parse_obo_terms(hpo_obo_path)

  # Read and prepare HPO annotations.
  hpo_ann <- read_hpo_gene_annotations(hpo_annotation_path)
  annotations <- prepare_hpo_annotations(hpo_ann)

  # Default universe is all HPO-annotated genes.
  if (is.null(universe)) {
    universe <- unique(annotations$gene)
  } else {
    universe <- clean_gene_input(universe)
  }

  # Propagate annotations through the HPO hierarchy if requested.
  if (propagate) {
    graph <- build_ontology_graph(term_info)
    annotations_used <- propagate_annotations(annotations, graph)
  } else {
    annotations_used <- annotations
  }

  # Run statistical enrichment.
  results <- run_fisher_enrichment(
    genes = genes,
    universe = universe,
    annotations = annotations_used,
    min_size = min_size
  )

  # Add readable phenotype names.
  results_named <- add_term_names(results, term_info)

  # Return a structured result object.
  list(
    ontology = "HPO",
    input_genes = genes,
    n_input_genes = length(genes),
    term_info = term_info,
    annotations_used = annotations_used,
    results = results,
    results_named = results_named
  )
}


#' Run MP enrichment
#'
#' Runs Mouse Phenotype enrichment for human genes by mapping them to mouse
#' orthologues and using MGI phenotype annotations.
#'
#' @param genes User gene input.
#' @param gene_col Column name if genes is a data frame or file.
#' @param mp_obo_path Path to MP ontology file.
#' @param ortholog_path Path to human-mouse orthologue file.
#' @param mgi_genepheno_path Path to MGI_GenePheno.rpt.txt.
#' @param universe Optional background genes.
#' @param min_size Minimum genes per term.
#' @param propagate Whether to propagate annotations to parent terms.
#' @return MP enrichment object.
#' @export
run_mp_enrichment <- function(genes,
                              gene_col = NULL,
                              mp_obo_path = "data-raw/MPheno_OBO.ontology.txt",
                              ortholog_path = "data-raw/One To one orthologs2026-06-08.tsv",
                              mgi_genepheno_path = "data-raw/MGI_GenePheno.rpt.txt",
                              universe = NULL,
                              min_size = 5,
                              propagate = TRUE) {

  # Clean user input genes.
  genes <- clean_gene_input(genes, gene_col = gene_col)

  # Parse MP ontology.
  mp_term_info <- parse_obo_terms(mp_obo_path)
  mp_graph <- build_ontology_graph(mp_term_info)

  # Read human-mouse orthologues and MGI annotations.
  orthologs <- read_orthologs(ortholog_path)
  mgi_annotations <- read_mgi_genepheno(mgi_genepheno_path)

  # Build human gene -> MP term annotation universe.
  annotations_all <- prepare_mp_universe_from_mgi(
    orthologs = orthologs,
    mgi_annotations = mgi_annotations
  )

  # Keep only columns needed for enrichment.
  annotations_for_enrichment <- annotations_all[, c("gene", "term_id")]

  # Default universe is all human genes with mouse MP mappings.
  if (is.null(universe)) {
    universe <- unique(annotations_for_enrichment$gene)
  } else {
    universe <- clean_gene_input(universe)
  }

  # Propagate MP annotations through the ontology if requested.
  if (propagate) {
    annotations_used <- propagate_annotations(
      annotations = annotations_for_enrichment,
      graph = mp_graph
    )
  } else {
    annotations_used <- annotations_for_enrichment
  }

  # Run statistical enrichment.
  results <- run_fisher_enrichment(
    genes = genes,
    universe = universe,
    annotations = annotations_used,
    min_size = min_size
  )

  # Add readable MP phenotype names.
  results_named <- add_term_names(results, mp_term_info)

  # Record which input genes mapped to mouse orthologues.
  mapped_input <- orthologs[orthologs$human_gene %in% genes, ]

  # Return a structured result object.
  list(
    ontology = "MP",
    input_genes = genes,
    n_input_genes = length(genes),
    mapped_input = mapped_input,
    n_mapped_genes = length(unique(mapped_input$human_gene)),
    term_info = mp_term_info,
    annotations_used = annotations_used,
    results = results,
    results_named = results_named
  )
}


#' Run phenotype enrichment
#'
#' Main user-facing function. The user chooses either HPO or MP enrichment.
#' The function does not allow both at the same time to keep the workflow simple.
#'
#' @param genes User gene input: vector, data frame, or file path.
#' @param ontology Ontology to use: "HPO" or "MP".
#' @param gene_col Column name if genes is a data frame or file.
#' @param universe Optional background gene set.
#' @param min_size Minimum genes per term.
#' @param propagate Whether to propagate annotations to parent terms.
#' @param hpo_obo_path Path to hp.obo.
#' @param hpo_annotation_path Path to genes_to_phenotype.txt.
#' @param mp_obo_path Path to MP ontology file.
#' @param ortholog_path Path to human-mouse orthologue file.
#' @param mgi_genepheno_path Path to MGI_GenePheno.rpt.txt.
#' @return HPO or MP enrichment object.
#' @export
run_pheno_enrichment <- function(genes,
                                 ontology = c("HPO", "MP"),
                                 gene_col = NULL,
                                 universe = NULL,
                                 min_size = 5,
                                 propagate = TRUE,
                                 hpo_obo_path = "data-raw/hp.obo",
                                 hpo_annotation_path = "data-raw/genes_to_phenotype.txt",
                                 mp_obo_path = "data-raw/MPheno_OBO.ontology.txt",
                                 ortholog_path = "data-raw/One To one orthologs2026-06-08.tsv",
                                 mgi_genepheno_path = "data-raw/MGI_GenePheno.rpt.txt") {

  # User must choose one ontology only.
  ontology <- match.arg(ontology)

  # Run HPO enrichment.
  if (ontology == "HPO") {

    return(run_hpo_enrichment(
      genes = genes,
      gene_col = gene_col,
      hpo_obo_path = hpo_obo_path,
      hpo_annotation_path = hpo_annotation_path,
      universe = universe,
      min_size = min_size,
      propagate = propagate
    ))
  }

  # Run MP enrichment.
  if (ontology == "MP") {

    return(run_mp_enrichment(
      genes = genes,
      gene_col = gene_col,
      mp_obo_path = mp_obo_path,
      ortholog_path = ortholog_path,
      mgi_genepheno_path = mgi_genepheno_path,
      universe = universe,
      min_size = min_size,
      propagate = propagate
    ))
  }
}


#' Make a clean enrichment table
#'
#' Creates a report-ready table of the top enriched terms.
#'
#' @param enrichment Output from run_pheno_enrichment().
#' @param n Number of top terms to show.
#' @param remove_broad_terms Whether to remove broad root/general terms.
#' @return Clean results table.
#' @export
make_results_table <- function(enrichment, n = 20, remove_broad_terms = TRUE) {

  # Extract named results.
  results <- enrichment$results_named

  # Optionally remove broad terms.
  if (remove_broad_terms) {
    results <- filter_results_basic(results)
  }

  # Sort by adjusted p-value.
  results <- results[order(results$padj), ]

  # Keep top n terms.
  results <- head(results, n)

  # Gene ratio = proportion of input genes linked to this term.
  results$gene_ratio <- results$selected_with_term /
    (results$selected_with_term + results$selected_without_term)

  # Build clean table.
  data.frame(
    Ontology = enrichment$ontology,
    Phenotype = results$term_name,
    Term_ID = results$term_id,
    Input_genes = results$selected_with_term,
    Gene_ratio = round(results$gene_ratio, 3),
    Background_genes = results$background_with_term,
    P_value = signif(results$p_value, 3),
    Adjusted_P_value = signif(results$padj, 3),
    stringsAsFactors = FALSE
  )
}


#' Plot top enriched phenotype terms
#'
#' Creates a horizontal bar plot of the strongest terms.
#'
#' @param enrichment Output from run_pheno_enrichment().
#' @param n Number of top terms to plot.
#' @param use_adjusted Whether to use adjusted p-values.
#' @param remove_broad_terms Whether to remove broad root/general terms.
#' @return ggplot object.
#' @export
plot_enrichment <- function(enrichment,
                            n = 10,
                            use_adjusted = TRUE,
                            remove_broad_terms = TRUE) {

  # Extract results.
  results <- enrichment$results_named

  # Optionally filter broad terms.
  if (remove_broad_terms) {
    results <- filter_results_basic(results)
  }

  # Choose p-value column.
  score_col <- if (use_adjusted) "padj" else "p_value"

  # Prepare plot data.
  plot_df <- results[
    !is.na(results[[score_col]]) &
      results[[score_col]] > 0,
  ]

  # Convert p-values into readable score.
  plot_df$score <- -log10(plot_df[[score_col]])

  # Keep top terms.
  plot_df <- head(plot_df[order(-plot_df$score), ], n)

  # Make bar plot.
  ggplot2::ggplot(
    plot_df,
    ggplot2::aes(x = reorder(term_name, score), y = score)
  ) +
    ggplot2::geom_col() +
    ggplot2::coord_flip() +
    ggplot2::labs(
      title = paste0(enrichment$ontology, " phenotype enrichment"),
      x = "Phenotype term",
      y = if (use_adjusted) "-log10(adjusted p-value)" else "-log10(p-value)"
    ) +
    ggplot2::theme_minimal()
}


#' Plot enriched phenotype terms as a bubble plot
#'
#' Creates a bubble plot showing gene ratio, significance, and gene count.
#'
#' @param enrichment Output from run_pheno_enrichment().
#' @param n Number of top terms.
#' @param use_adjusted Whether to use adjusted p-values.
#' @param label_threshold Label terms above this -log10 value.
#' @param remove_broad_terms Whether to remove broad root/general terms.
#' @return ggplot object.
#' @export
plot_enrichment_bubble <- function(enrichment,
                                   n = 20,
                                   use_adjusted = TRUE,
                                   label_threshold = 1.3,
                                   remove_broad_terms = TRUE) {

  # Extract results.
  results <- enrichment$results_named

  # Optionally remove broad terms.
  if (remove_broad_terms) {
    results <- filter_results_basic(results)
  }

  # Choose p-value column.
  p_col <- if (use_adjusted) "padj" else "p_value"

  # Prepare plot data.
  plot_df <- results[
    !is.na(results[[p_col]]) &
      results[[p_col]] > 0,
  ]

  # Convert p-value into significance score.
  plot_df$neg_log_p <- -log10(plot_df[[p_col]])

  # Gene ratio = proportion of input genes linked to this phenotype.
  plot_df$gene_ratio <- plot_df$selected_with_term /
    (plot_df$selected_with_term + plot_df$selected_without_term)

  # Keep top terms.
  plot_df <- head(plot_df[order(-plot_df$neg_log_p), ], n)

  # Label strongest terms only.
  plot_df$label_text <- ifelse(
    plot_df$neg_log_p >= label_threshold,
    plot_df$term_name,
    ""
  )

  # Make bubble plot.
  ggplot2::ggplot(
    plot_df,
    ggplot2::aes(
      x = gene_ratio,
      y = neg_log_p,
      size = selected_with_term,
      label = label_text
    )
  ) +
    ggplot2::geom_point(alpha = 0.7) +
    ggplot2::geom_text(
      check_overlap = TRUE,
      vjust = -0.8,
      size = 3
    ) +
    ggplot2::labs(
      title = paste0(enrichment$ontology, " phenotype enrichment bubble plot"),
      x = "Gene ratio",
      y = if (use_adjusted) "-log10(adjusted p-value)" else "-log10(p-value)",
      size = "Input genes"
    ) +
    ggplot2::theme_minimal()
}


#' Example gene sets
#'
#' Provides small built-in example gene sets so users can test the package.
#'
#' @param example Example name: "cataract" or "cardiac".
#' @return Character vector of example genes.
#' @export
example_genes <- function(example = c("cataract", "cardiac")) {

  # User chooses one example.
  example <- match.arg(example)

  # Cataract/lens gene set.
  if (example == "cataract") {
    return(c(
      "CRYAA", "CRYAB", "CRYBB1", "CRYBB2", "CRYGC",
      "GJA8", "MIP", "BFSP2", "PAX6", "MAF"
    ))
  }

  # Cardiomyopathy gene set.
  if (example == "cardiac") {
    return(c(
      "ACTC1", "ACTN2", "BAG3", "DES", "DMD",
      "LMNA", "MYH7", "MYBPC3", "TNNT2", "TNNI3"
    ))
  }
}


#' Run a default example
#'
#' Lets users test the package using a small built-in gene set.
#'
#' @param example Example gene set: "cataract" or "cardiac".
#' @param ontology Ontology to run: "HPO" or "MP".
#' @return Enrichment output.
#' @export
run_example <- function(example = c("cataract", "cardiac"),
                        ontology = c("HPO", "MP")) {

  # Choose example and ontology.
  example <- match.arg(example)
  ontology <- match.arg(ontology)

  # Get example genes.
  genes <- example_genes(example)

  # Run chosen enrichment.
  run_pheno_enrichment(
    genes = genes,
    ontology = ontology
  )
}
