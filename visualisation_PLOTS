#' Bubble plot for phenotype enrichment results
#'
#' Creates a GOplot-style bubble plot for HPO/MP enrichment results.
#'
#' @param results Enrichment results data frame.
#' @param n Number of top terms to show.
#' @param use_adjusted If TRUE, use adjusted p-values.
#' @param label_threshold Only label terms above this -log10(p-value) threshold.
#' @return A ggplot object.
#' @export
plot_enrichment_bubble <- function(results,
                                   n = 20,
                                   use_adjusted = TRUE,
                                   label_threshold = 1.3) {

  plot_df <- results

  p_col <- if (use_adjusted) "padj" else "p_value"

  plot_df <- plot_df[!is.na(plot_df[[p_col]]), ]
  plot_df <- plot_df[plot_df[[p_col]] > 0, ]

  plot_df$neg_log_p <- -log10(plot_df[[p_col]])

  plot_df$gene_ratio <- plot_df$selected_with_term /
    (plot_df$selected_with_term + plot_df$selected_without_term)

  if (!"term_name" %in% names(plot_df)) {
    plot_df$term_name <- plot_df$term_id
  }

  plot_df <- plot_df[order(-plot_df$neg_log_p), ]
  plot_df <- head(plot_df, n)

  plot_df$label_text <- ifelse(
    plot_df$neg_log_p >= label_threshold,
    plot_df$term_name,
    ""
  )

  ggplot2::ggplot(
    plot_df,
    ggplot2::aes(
      x = gene_ratio,
      y = neg_log_p,
      size = selected_with_term,
      label = label_text
    )
  ) +
    ggplot2::geom_point(alpha = 0.7) +
    ggplot2::geom_text(
      check_overlap = TRUE,
      vjust = -0.8,
      size = 3
    ) +
    ggplot2::labs(
      title = "Phenotype enrichment bubble plot",
      x = "Gene ratio",
      y = if (use_adjusted) "-log10(adjusted p-value)" else "-log10(p-value)",
      size = "Panel genes"
    ) +
    ggplot2::theme_minimal()
}

