# ============================================================
# preprocessing.R
# phenoEnrichR preprocessing functions
#
# Purpose:
# This file contains helper functions that prepare ontology and
# annotation data before enrichment is run.
#
# Users should NOT normally call these functions directly.
# They are used internally by the main enrichment function.
# ============================================================


#' Read an ontology OBO file
#'
#' Reads an ontology file as plain text.
#' Used for both HPO and MP ontology files.
#'
#' @param path Path to an OBO ontology file.
#' @return Character vector of file lines.
#' @export
read_obo <- function(path) {

  # Check that the ontology file exists.
  if (!file.exists(path)) {
    stop("OBO file does not exist: ", path)
  }

  # Read the ontology file line by line.
  readLines(path, warn = FALSE)
}


#' Parse ontology terms from an OBO file
#'
#' Extracts term IDs, term names, and parent terms from an OBO file.
#' This works for HPO and MP because both are ontology DAGs.
#'
#' @param path Path to an OBO ontology file.
#' @return Data frame with term_id, term_name, and parent_id.
#' @export
parse_obo_terms <- function(path) {

  # Read OBO text.
  lines <- read_obo(path)

  # Each ontology term begins with [Term].
  term_starts <- which(lines == "[Term]")

  # Store parsed term blocks.
  results <- list()

  # Loop through all term blocks.
  for (i in seq_along(term_starts)) {

    start <- term_starts[i]

    # End at the line before the next term block.
    end <- if (i < length(term_starts)) {
      term_starts[i + 1] - 1
    } else {
      length(lines)
    }

    block <- lines[start:end]

    # Extract ontology ID, name, and parent terms.
    id_line <- grep("^id: ", block, value = TRUE)
    name_line <- grep("^name: ", block, value = TRUE)
    parent_lines <- grep("^is_a: ", block, value = TRUE)

    # Skip incomplete or malformed terms.
    if (length(id_line) == 0 || length(name_line) == 0) next

    term_id <- sub("^id: ", "", id_line[1])
    term_name <- sub("^name: ", "", name_line[1])

    # Terms with no parent get NA.
    if (length(parent_lines) == 0) {

      results[[length(results) + 1]] <- data.frame(
        term_id = term_id,
        term_name = term_name,
        parent_id = NA_character_,
        stringsAsFactors = FALSE
      )

    } else {

      # Parent line example:
      # is_a: HP:0000001 ! All
      parent_ids <- sub("^is_a: ", "", parent_lines)
      parent_ids <- sub(" !.*$", "", parent_ids)

      results[[length(results) + 1]] <- data.frame(
        term_id = term_id,
        term_name = term_name,
        parent_id = parent_ids,
        stringsAsFactors = FALSE
      )
    }
  }

  # Combine all parsed terms into one table.
  dplyr::bind_rows(results)
}


#' Build ontology graph
#'
#' Converts parsed ontology terms into a term-to-parent list.
#'
#' @param term_info Data frame from parse_obo_terms().
#' @return Named list mapping each term to its parent terms.
#' @export
build_ontology_graph <- function(term_info) {

  # This graph lets us move from child terms to parent terms.
  split(term_info$parent_id, term_info$term_id)
}


#' Get ancestor terms
#'
#' Finds all parent terms above a given ontology term.
#'
#' @param term One ontology term ID.
#' @param graph Named list from build_ontology_graph().
#' @param visited Internal safety argument to avoid repeated terms.
#' @return Character vector of ancestor term IDs, including the input term.
#' @export
get_ancestors <- function(term, graph, visited = character()) {

  # Stop if term is missing or already visited.
  if (is.na(term) || term %in% visited) {
    return(character())
  }

  # Get parent terms.
  parents <- graph[[term]]

  # If term has no parents, return the term itself.
  if (is.null(parents) || all(is.na(parents))) {
    return(term)
  }

  # Remove missing parent entries.
  parents <- parents[!is.na(parents)]

  # Recursively get ancestors of each parent.
  ancestor_list <- lapply(parents, function(parent) {
    get_ancestors(parent, graph, visited = c(visited, term))
  })

  # Return original term plus all ancestors.
  unique(c(term, unlist(ancestor_list)))
}


#' Propagate annotations through ontology hierarchy
#'
#' Expands direct gene-term annotations so genes are also annotated
#' to parent ontology terms.
#'
#' @param annotations Data frame with gene and term_id columns.
#' @param graph Ontology graph from build_ontology_graph().
#' @return Expanded gene-to-term annotation data frame.
#' @export
propagate_annotations <- function(annotations, graph) {

  # Keep only required enrichment columns.
  annotations <- annotations[, c("gene", "term_id")]
  annotations$gene <- as.character(annotations$gene)
  annotations$term_id <- as.character(annotations$term_id)

  # Add ancestor terms for every gene-term annotation.
  expanded_list <- lapply(seq_len(nrow(annotations)), function(i) {

    gene <- annotations$gene[i]
    term <- annotations$term_id[i]

    ancestors <- get_ancestors(term, graph)

    data.frame(
      gene = gene,
      term_id = ancestors,
      stringsAsFactors = FALSE
    )
  })

  # Combine and remove duplicate gene-term rows.
  expanded <- do.call(rbind, expanded_list)
  unique(expanded)
}


#' Clean user gene input
#'
#' Accepts a character vector, data frame, or file path and returns
#' a clean vector of gene identifiers.
#'
#' @param genes Character vector, data frame, or file path.
#' @param gene_col Column name if genes is a data frame or file.
#' @return Clean character vector of genes.
#' @export
clean_gene_input <- function(genes, gene_col = NULL) {

  # Case 1: user gives a file path.
  if (length(genes) == 1 && is.character(genes) && file.exists(genes)) {

    # Read CSV or TSV based on file extension.
    if (grepl("\\.csv$", genes, ignore.case = TRUE)) {
      df <- read.csv(genes, stringsAsFactors = FALSE)
    } else {
      df <- read.delim(genes, stringsAsFactors = FALSE)
    }

    # If gene_col is not supplied, use first column.
    if (is.null(gene_col)) {
      gene_col <- names(df)[1]
    }

    genes <- df[[gene_col]]
  }

  # Case 2: user gives a data frame.
  if (is.data.frame(genes)) {

    # If gene_col is not supplied, use first column.
    if (is.null(gene_col)) {
      gene_col <- names(genes)[1]
    }

    genes <- genes[[gene_col]]
  }

  # Case 3: user gives a vector.
  genes <- unique(as.character(genes))

  # Remove missing and empty entries.
  genes <- genes[!is.na(genes)]
  genes <- genes[genes != ""]

  # Standardise spacing.
  genes <- trimws(genes)

  unique(genes)
}


#' Read HPO gene-to-phenotype annotations
#'
#' Reads genes_to_phenotype.txt from HPO.
#'
#' @param path Path to genes_to_phenotype.txt.
#' @return Data frame with gene_symbol, hpo_id, and hpo_name.
#' @export
read_hpo_gene_annotations <- function(path) {

  # Check that the HPO annotation file exists.
  if (!file.exists(path)) {
    stop("HPO annotation file does not exist: ", path)
  }

  # Read HPO annotation file.
  df <- read.delim(
    path,
    header = TRUE,
    sep = "\t",
    stringsAsFactors = FALSE,
    quote = ""
  )

  # Keep only required columns.
  out <- df[, c("gene_symbol", "hpo_id", "hpo_name")]

  # Remove duplicate rows.
  unique(out)
}


#' Prepare HPO annotations
#'
#' Converts HPO annotation columns into standard gene and term_id format.
#'
#' @param hpo_ann Output from read_hpo_gene_annotations().
#' @return Data frame with gene and term_id.
#' @export
prepare_hpo_annotations <- function(hpo_ann) {

  # Keep gene symbol and HPO term ID.
  out <- hpo_ann[, c("gene_symbol", "hpo_id")]

  # Rename to standard enrichment column names.
  names(out) <- c("gene", "term_id")

  # Remove duplicates.
  unique(out)
}


#' Read human-mouse one-to-one orthologues
#'
#' Standardises the orthologue file for MP enrichment.
#'
#' @param path Path to orthologue TSV file.
#' @return Data frame with human_gene, human_id, mouse_gene, mouse_mgi_id.
#' @export
read_orthologs <- function(path) {

  # Check that orthologue file exists.
  if (!file.exists(path)) {
    stop("Orthologue file does not exist: ", path)
  }

  # Read orthologue file.
  df <- read.delim(
    path,
    sep = "\t",
    header = TRUE,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )

  # Standardise columns based on your orthologue file structure.
  out <- data.frame(
    human_gene = rownames(df),
    human_id = df[["Human Gene Symbol"]],
    mouse_gene = df[["Mgi Gene Acc Id"]],
    mouse_mgi_id = df[["Mouse Support Count Threshold"]],
    stringsAsFactors = FALSE
  )

  # Keep only valid MGI mappings.
  out <- unique(out)
  out <- out[
    !is.na(out$human_gene) &
      !is.na(out$mouse_gene) &
      !is.na(out$mouse_mgi_id) &
      grepl("^MGI:", out$mouse_mgi_id),
  ]

  rownames(out) <- NULL
  out
}


#' Read MGI gene-to-MP phenotype annotations
#'
#' Extracts mouse MGI IDs and MP term IDs from MGI_GenePheno.rpt.txt.
#'
#' @param path Path to MGI_GenePheno.rpt.txt.
#' @return Data frame with mouse_mgi_id and term_id.
#' @export
read_mgi_genepheno <- function(path) {

  # Check that MGI file exists.
  if (!file.exists(path)) {
    stop("MGI gene-phenotype file does not exist: ", path)
  }

  # Read MGI report.
  df <- read.delim(
    path,
    sep = "\t",
    header = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    fill = TRUE
  )

  # In this file:
  # column 7 = MGI gene ID
  # column 5 = MP term ID
  out <- data.frame(
    mouse_mgi_id = df[[7]],
    term_id = df[[5]],
    stringsAsFactors = FALSE
  )

  # Keep valid MGI and MP IDs.
  out <- unique(out)
  out <- out[
    !is.na(out$mouse_mgi_id) &
      !is.na(out$term_id) &
      grepl("^MGI:", out$mouse_mgi_id) &
      grepl("^MP:", out$term_id),
  ]

  rownames(out) <- NULL
  out
}


#' Prepare MP annotation universe from MGI
#'
#' Joins human-mouse orthologues with MGI MP annotations.
#'
#' @param orthologs Output from read_orthologs().
#' @param mgi_annotations Output from read_mgi_genepheno().
#' @return Data frame with gene, term_id, mouse_gene, mouse_mgi_id.
#' @export
prepare_mp_universe_from_mgi <- function(orthologs, mgi_annotations) {

  # Merge by mouse MGI ID.
  merged <- merge(
    orthologs,
    mgi_annotations,
    by = "mouse_mgi_id"
  )

  # Use original human gene as the enrichment gene.
  out <- data.frame(
    gene = merged$human_gene,
    term_id = merged$term_id,
    mouse_gene = merged$mouse_gene,
    mouse_mgi_id = merged$mouse_mgi_id,
    stringsAsFactors = FALSE
  )

  # Remove duplicate gene-term annotations.
  out <- unique(out)
  rownames(out) <- NULL

  out
}
