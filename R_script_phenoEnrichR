#' Compare HPO enrichment methods
#'
#' Runs flat enrichment, propagated enrichment, and simple elim-pruned enrichment.
#' This supports the project aim of comparing ontology-aware approaches.
#'
#' @param genes User-supplied human gene set.
#' @param hpo_obo_path Path to hp.obo.
#' @param hpo_annotation_path Path to HPO gene annotations.
#' @param universe Optional background genes.
#' @param min_size Minimum genes per term.
#' @return List containing flat, propagated, and pruned results.
#' @export
compare_hpo_methods <- function(genes,
                                hpo_obo_path = "data-raw/hp.obo",
                                hpo_annotation_path = "data-raw/genes_to_phenotype.txt",
                                universe = NULL,
                                min_size = 5) {

  # Parse HPO ontology.
  term_info <- parse_obo_terms(hpo_obo_path)

  # Read and prepare HPO annotations.
  hpo_ann <- read_hpo_gene_annotations(hpo_annotation_path)
  annotations <- prepare_hpo_annotations(hpo_ann)

  # Use all annotated genes as default universe.
  if (is.null(universe)) {
    universe <- unique(annotations$gene)
  }

  # Build ontology graph.
  graph <- build_ontology_graph(term_info)

  # 1. Flat analysis: direct annotations only.
  flat_results <- run_fisher_enrichment(
    genes = genes,
    universe = universe,
    annotations = annotations,
    min_size = min_size
  )

  flat_results <- add_term_names(flat_results, term_info)

  # 2. Propagated analysis: annotations include ancestors.
  annotations_prop <- propagate_annotations(annotations, graph)

  prop_results <- run_fisher_enrichment(
    genes = genes,
    universe = universe,
    annotations = annotations_prop,
    min_size = min_size
  )

  prop_results <- add_term_names(prop_results, term_info)

  # 3. Pruned analysis: reduce broad parent-term inflation.
  pruned_results <- elim_prune_enrichment(
    genes = genes,
    universe = universe,
    annotations = annotations_prop,
    term_info = term_info,
    min_size = min_size,
    alpha = 0.05
  )

  list(
    term_info = term_info,
    annotations = annotations,
    annotations_prop = annotations_prop,
    flat = flat_results,
    propagated = prop_results,
    pruned = pruned_results
  )
}


