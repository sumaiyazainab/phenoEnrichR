#' Compare enrichment under different background universes
#'
#' Runs the same enrichment analysis using multiple background gene sets.
#' This addresses the project requirement to assess background-set effects.
#'
#' @param genes User-supplied gene set.
#' @param annotations Gene-to-term annotation table.
#' @param term_info Parsed ontology table.
#' @param universes Named list of background gene vectors.
#' @param min_size Minimum genes per term.
#' @return Named list of enrichment result tables.
#' @export
compare_universes <- function(genes,
                              annotations,
                              term_info,
                              universes,
                              min_size = 5) {

  # Run enrichment once per background universe.
  out <- lapply(names(universes), function(name) {

    universe <- universes[[name]]

    res <- run_fisher_enrichment(
      genes = genes,
      universe = universe,
      annotations = annotations,
      min_size = min_size
    )

    # Add term names and universe label.
    res <- add_term_names(res, term_info)
    res$universe_name <- name

    res
  })

  # Name list outputs by universe name.
  names(out) <- names(universes)

  out
}


