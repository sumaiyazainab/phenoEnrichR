#' Read gene-to-term annotations
#'
#' Reads a tab-delimited annotation table and standardizes the column names.
#'
#' @param path Path to the annotation file.
#' @param gene_col Name of the gene column.
#' @param term_col Name of the term ID column.
#' @return A data frame with columns gene and term_id.
#' @export
read_annotations <- function(path, gene_col = "gene", term_col = "term_id") {
  df <- read.delim(path, header = TRUE, sep = "\t", stringsAsFactors = FALSE)
  df <- df[, c(gene_col, term_col)]
  names(df) <- c("gene", "term_id")
  unique(df)
}


#' Prepare HPO annotations for enrichment
#'
#' Converts HPO annotation data into the standard format used by the package.
#'
#' @param hpo_ann Data frame returned by read_hpo_gene_annotations()
#' @return A data frame with columns gene and term_id
#' @export
prepare_hpo_annotations <- function(hpo_ann) {
  out <- hpo_ann[, c("gene_symbol", "hpo_id")]
  names(out) <- c("gene", "term_id")
  unique(out)
}


#' Read HPO gene-to-phenotype annotations
#'
#' Reads the HPO genes_to_phenotype.txt file and keeps the main columns.
#'
#' @param path Path to genes_to_phenotype.txt
#' @return A data frame with gene_symbol, hpo_id, hpo_name
#' @export
read_hpo_gene_annotations <- function(path) {
  df <- read.delim(
    path,
    header = TRUE,
    sep = "\t",
    stringsAsFactors = FALSE,
    quote = ""
  )

  out <- df[, c("gene_symbol", "hpo_id", "hpo_name")]
  out <- unique(out)

  out
}
